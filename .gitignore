node_modules

# Ignore environment files containing secrets
/server/.env
/server/.env.*
/server/.env.local
/server/.env.production
/server/.evn
/server/.evn.*
/client/.env
/client/.env.*
/client/.env.local
/client/.evn
/client/.evn.*
!**/.env.example
!**/env.example
*.pem
*.key

# Ignore test artifacts and reports
/client/playwright-report/
/client/test-results/

# Archive/legacy folder
/server/legacy/
/server/backup/
/Zerohook/

# Keep Android app source files trackable
!/mobile/android/app/src/main/java/
!/mobile/android/app/src/main/java/**

# Android generated/build artifacts
/mobile/android/.gradle/
/mobile/android/.kotlin/
/mobile/android/.idea/
/mobile/android/local.properties
/mobile/android/captures/
/mobile/android/**/build/

# Claude Code temp files
tmpclaude-*
client/tmpclaude-*
nul

# Build artifacts (generated on deploy, not committed)
client/build/

# Incident recovery artifacts (local forensic backups)
server/recovery-artifacts/
