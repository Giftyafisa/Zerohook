{
  "name": "zerohook-platform",
  "version": "1.0.0",
  "description": "Zerohook - Secure service marketplace platform",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "build": "cd client && npm install && npm run build",
    "test": "jest",
    "prepare": "node tools/install-git-hooks.js",
    "hooks:install": "node tools/install-git-hooks.js",
    "ui:baseline:check": "node tools/run-ui-baseline.js --mode=check --pack=public-core",
    "ui:baseline:update": "node tools/run-ui-baseline.js --mode=update --pack=public-core",
    "ui:baseline:check:all": "node tools/run-ui-baseline.js --mode=check --pack=all",
    "ui:baseline:update:all": "node tools/run-ui-baseline.js --mode=update --pack=all",
    "ui:gate": "npm run ui:baseline:check",
    "ui:remediate": "node tools/ui-safe-remediate.js --write",
    "ui:remediate:dry": "node tools/ui-safe-remediate.js --dry-run",
    "lint:agent-commands": "node tools/agent-command-map-lint.js",
    "check:agents": "npm run lint:agent-commands",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "keywords": [
    "marketplace",
    "services",
    "escrow",
    "trust",
    "blockchain"
  ],
  "author": "Zerohook Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.3"
  },
  "dependencies": {
    "axios": "^1.13.2"
  }
}
