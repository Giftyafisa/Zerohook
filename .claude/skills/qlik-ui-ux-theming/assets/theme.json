      {
        "name": "Corporate 12",
        "translation": "Corporate Colors",
        "propertyValue": "12",
        "type": "pyramid",
        "colors": [
          "@primary",
          "@secondary",
          "#4A4A4A",
          "#7B7B7B",
          "#B2B2B2",
          "#E5E5E5",
          "#1D4E89",
          "#00B2A9",
          "#F2A900",
          "#D9534F",
          "#8E44AD",
          "#27AE60"
        ]
      }
    ],
    "ui": [
      {
        "name": "UI Colors",
        "colors": ["@white", "@textPrimary", "@primary"]
      }
    ]
  },
  "scales": [
    {
      "name": "Corporate Sequential",
      "translation": "Sequential Blue",
      "propertyValue": "sg",
      "type": "gradient",
      "colors": ["@accent", "@primary"]
    },
    {
      "name": "Corporate Diverging",
      "translation": "Diverging Red-Blue",
      "propertyValue": "dg",
      "type": "gradient",
      "colors": ["#D9534F", "@white", "@primary"]
    }
  ],
  "color": "@textPrimary",
