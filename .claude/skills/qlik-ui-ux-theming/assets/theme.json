        "fontSize": "13px"
      },
      "footer": {
        "color": "#999999",
        "fontSize": "11px",
        "fontStyle": "italic"
      }
    },
    "kpi": {
      "backgroundColor": "@white",
      "title": {
        "main": {
          "color": "@textSecondary",
          "fontSize": "14px",
          "fontWeight": "normal"
        }
      },
      "value": {
        "color": "@primary",
        "fontSize": "32px",
        "fontWeight": "bold"
      }
    },
    "table": {
      "backgroundColor": "@white",
      "header": {
        "color": "@primary",
        "fontSize": "13px",
        "fontWeight": "bold"
      },
      "content": {
        "color": "@textPrimary",
        "fontSize": "13px"
      },
      "hover": {
