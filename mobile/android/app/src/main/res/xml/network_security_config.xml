<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production: HTTPS only for all domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">zerohook-api-f3ss.onrender.com</domain>
        <domain includeSubdomains="true">zerohook.com</domain>
        <domain includeSubdomains="true">opue.me</domain>
    </domain-config>
    
    <!-- Default: HTTPS only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
