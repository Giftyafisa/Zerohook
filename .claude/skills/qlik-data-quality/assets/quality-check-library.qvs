//
// CALL CheckMinRows('Orders', 1000);
// CALL CheckNulls('Orders', 'CustomerID', 1);
// CALL CheckDuplicates('Orders', 'OrderID');
// CALL CheckFK('Orders', 'CustomerID', 'Customers', 'CustomerID');
// CALL CheckFreshness('Orders', 'OrderDate', 7);
//
// CALL QualityGate();
// ============================================================
