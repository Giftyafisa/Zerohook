# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
DATABASE_URL=postgresql://zerohook:9gc8nNYOUAWP6fwcnogoANkLleKLcFYA@dpg-d4m9bqili9vc73emk150-a.oregon-postgres.render.com/zerohookdb?sslmode=require

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=zerohook-super-secret-jwt-key-2024-change-in-production
JWT_EXPIRE=7d

# Stripe Configuration (REMOVED - crypto only)
# STRIPE_SECRET_KEY=removed
# STRIPE_PUBLISHABLE_KEY=removed

# Paystack Configuration (REMOVED - crypto only)
# PAYSTACK_SECRET_KEY=removed
# PAYSTACK_PUBLIC_KEY=removed

# Crypto Payment Configuration (Fee-Free Direct Blockchain)
CRYPTO_MASTER_SEED=change-this-in-production
BITCOIN_NETWORK=mainnet
PLATFORM_FEE_PERCENT=5

# Blockchain Configuration
POLYGON_RPC_URL=https://polygon-rpc.com
ESCROW_PRIVATE_KEY=your_escrow_wallet_private_key
ESCROW_CONTRACT_ADDRESS=0x...

# External Services
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
SENDGRID_API_KEY=your_sendgrid_api_key

# Cloudinary Configuration (Image Hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudflare R2 Storage (Primary for profile uploads)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# Public base URL for your bucket or custom domain (no trailing slash)
R2_PUBLIC_BASE_URL=https://your-public-r2-domain.com

# Cloudflare Image Optimization (choose one mode)
# 1) Worker mode: worker endpoint that accepts ?url=&width=&height=&fit=&quality=&format=
CF_IMAGE_WORKER_BASE_URL=
# 2) cdn-cgi mode: zone base URL (e.g. https://media.opue.me) for /cdn-cgi/image/
CF_IMAGE_CDN_BASE_URL=
CF_IMAGE_QUALITY=85
CF_IMAGE_FIT=cover

# Security Configuration
ENCRYPTION_KEY=zerohook-32-byte-encryption-2024
CLIENT_URL=http://localhost:3000

# Browser Push Notifications
# Keep the private key secret and set the same key pair used by the client.
WEB_PUSH_VAPID_PUBLIC_KEY=your_vapid_public_key_here
WEB_PUSH_VAPID_PRIVATE_KEY=your_vapid_private_key_here
WEB_PUSH_SUBJECT=mailto:support@zerohook.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Country Detection
DEFAULT_COUNTRY=NG
SUPPORTED_COUNTRIES=NG,GH,KE,ZA,UG,TZ,RW,BW,ZM,MW

# IP Geolocation (ipgeolocation.io)
IP_GEOLOCATION_API_KEY=1d24707d2a554ee697b852f28dd6533e

# AI/ML Services (optional)
OPENAI_API_KEY=your_openai_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key
