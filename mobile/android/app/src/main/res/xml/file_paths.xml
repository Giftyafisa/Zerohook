<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
        Scoped FileProvider paths — only expose directories the app actually uses.
        Previous config exposed root "." of every storage area which is over-broad.
    -->

    <!-- Camera captures (temporary photos before upload) -->
    <cache-path name="camera_cache" path="camera/" />

    <!-- Profile pictures and uploaded media -->
    <external-files-path name="images" path="Pictures/" />

    <!-- Downloaded/shared files -->
    <files-path name="internal_files" path="shared/" />
</paths>
